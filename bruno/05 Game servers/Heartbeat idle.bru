meta {
  name: Heartbeat idle
  type: http
  seq: 3
}

put {
  url: {{serverlistUrl}}/servers/{{serverId}}/heartbeat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serverToken}}
}

body:json {
  {
    "status": "idle",
    "players": 0,
    "map": "arena"
  }
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("idle", () => expect(res.body.status).to.equal("idle"));
}
