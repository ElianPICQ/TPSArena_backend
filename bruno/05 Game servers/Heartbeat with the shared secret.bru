meta {
  name: Heartbeat with the shared secret
  type: http
  seq: 2
}

put {
  url: {{serverlistUrl}}/servers/{{serverId}}/heartbeat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{gameServerSecret}}
}

body:json {
  {
    "status": "idle",
    "players": 0,
    "map": "arena"
  }
}

tests {
  test("status 401", () => expect(res.status).to.equal(401));
  test("invalid_server_token", () => expect(res.body.error).to.equal("invalid_server_token"));
}
