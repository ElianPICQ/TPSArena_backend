meta {
  name: Get a profile
  type: http
  seq: 2
}

get {
  url: {{bffUrl}}/profiles/{{aliceId}}
  auth: bearer
}

auth:bearer {
  token: {{bobAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("bio", () => expect(res.body.bio).to.equal("Hello from Bruno"));
}
