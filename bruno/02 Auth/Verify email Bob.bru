meta {
  name: Verify email Bob
  type: http
  seq: 6
}

post {
  url: {{bffUrl}}/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "email": "",
    "code": ""
  }
}

script:pre-request {
  const axios = require("axios");

  async function mailCode(email, subject) {
    for (let i = 0; i < 30; i++) {
      const { data } = await axios.get(`${bru.getEnvVar("mailpitUrl")}/api/v1/messages`);
      const message = data.messages.find((m) => m.To[0].Address === email && m.Subject.includes(subject));
      const code = message?.Snippet.match(/\d{6}/)?.[0];
      if (code) return code;
      await bru.sleep(300);
    }
    throw new Error(`No "${subject}" email for ${email} in Mailpit`);
  }

  const email = bru.getVar("bobEmail");
  req.setBody({ email, code: await mailCode(email, "verification") });
}

script:post-response {
  bru.setVar("bobAccess", res.body.access_token);
  bru.setVar("bobRefresh", res.body.refresh_token);
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("returns tokens", () => expect(res.body.access_token).to.be.a("string"));
}

docs {
  The code is read from Mailpit by the pre-request script.
}
