meta {
  name: Login with a wrong password
  type: http
  seq: 8
}

post {
  url: {{bffUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{aliceEmail}}",
    "password": "wrong-password"
  }
}

tests {
  test("status 401", () => expect(res.status).to.equal(401));
  test("invalid_credentials", () => expect(res.body.error).to.equal("invalid_credentials"));
}
