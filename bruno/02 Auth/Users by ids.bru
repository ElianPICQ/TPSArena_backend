meta {
  name: Users by ids
  type: http
  seq: 11
}

get {
  url: {{bffUrl}}/auth/users?ids={{aliceId}},{{bobId}}
  auth: bearer
}

params:query {
  ids: {{aliceId}},{{bobId}}
}

auth:bearer {
  token: {{aliceAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("both names", () => expect(res.body.users.map((u) => u.username)).to.have.members([bru.getVar("aliceName"), bru.getVar("bobName")]));
}
