meta {
  name: Register Bob
  type: http
  seq: 5
}

post {
  url: {{bffUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{bobEmail}}",
    "username": "{{bobName}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("bobId", res.body.user_id);
}

tests {
  test("status 201", () => expect(res.status).to.equal(201));
}
