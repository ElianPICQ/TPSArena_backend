meta {
  name: Me
  type: http
  seq: 10
}

get {
  url: {{bffUrl}}/auth/me
  auth: bearer
}

auth:bearer {
  token: {{aliceAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("Alice", () => expect(res.body.user_id).to.equal(bru.getVar("aliceId")));
  test("own email", () => expect(res.body.email).to.equal(bru.getVar("aliceEmail")));
}
