meta {
  name: Refresh Alice
  type: http
  seq: 9
}

post {
  url: {{bffUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{aliceRefresh}}"
  }
}

script:pre-request {
  bru.setVar("aliceOldRefresh", bru.getVar("aliceRefresh"));
}

script:post-response {
  bru.setVar("aliceAccess", res.body.access_token);
  bru.setVar("aliceRefresh", res.body.refresh_token);
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("rotated", () => expect(res.body.refresh_token).to.not.equal(bru.getVar("aliceOldRefresh")));
}
