meta {
  name: Register Alice
  type: http
  seq: 1
}

post {
  url: {{bffUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{aliceEmail}}",
    "username": "{{aliceName}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  // New players each run.
  const runId = Date.now().toString(36);
  bru.setVar("runId", runId);
  bru.setVar("buildVersion", `bruno-${runId}`);
  for (const name of ["alice", "bob"]) {
    bru.setVar(`${name}Email`, `${name}_${runId}@example.dev`);
    bru.setVar(`${name}Name`, `${name}_${runId}`);
  }
}

script:post-response {
  bru.setVar("aliceId", res.body.user_id);
}

tests {
  test("status 201", () => expect(res.status).to.equal(201));
  test("no tokens before verification", () => expect(res.body).to.not.have.property("access_token"));
}
