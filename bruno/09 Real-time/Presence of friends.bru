meta {
  name: Presence of friends
  type: http
  seq: 1
}

get {
  url: {{bffUrl}}/presence?ids={{bobId}}
  auth: bearer
}

params:query {
  ids: {{bobId}}
}

auth:bearer {
  token: {{aliceAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("Bob is offline (no socket)", () => expect(res.body.presence[0].status).to.equal("offline"));
}

docs {
  Only friends are answered; other ids are left out.
}
