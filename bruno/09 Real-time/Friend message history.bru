meta {
  name: Friend message history
  type: http
  seq: 2
}

get {
  url: {{bffUrl}}/conversations/{{bobId}}/messages?limit=20
  auth: bearer
}

params:query {
  limit: 20
}

auth:bearer {
  token: {{aliceAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("no messages yet", () => expect(res.body.messages).to.have.lengthOf(0));
}
