meta {
  name: Heartbeat learns the reservation
  type: http
  seq: 1
}

put {
  url: {{serverlistUrl}}/servers/{{serverId}}/heartbeat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serverToken}}
}

body:json {
  {
    "status": "idle",
    "players": 0,
    "map": "arena"
  }
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("reserved for the party", () => {
    expect(res.body.status).to.equal("reserved");
    expect(res.body.party_id).to.equal(bru.getVar("partyId"));
  });
}
