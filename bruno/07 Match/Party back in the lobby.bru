meta {
  name: Party back in the lobby
  type: http
  seq: 7
}

get {
  url: {{bffUrl}}/parties/{{partyId}}
  auth: bearer
}

auth:bearer {
  token: {{aliceAccess}}
}

script:pre-request {
  await bru.sleep(1000); // Social's worker handles server.removed
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("lobby", () => expect(res.body.status).to.equal("lobby"));
}
