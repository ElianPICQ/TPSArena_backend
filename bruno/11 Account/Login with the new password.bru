meta {
  name: Login with the new password
  type: http
  seq: 7
}

post {
  url: {{bffUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{bobEmail}}",
    "password": "{{newPassword}}"
  }
}

script:post-response {
  bru.setVar("bobAccess", res.body.access_token);
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
}
