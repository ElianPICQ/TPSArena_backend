meta {
  name: Confirm the password reset
  type: http
  seq: 6
}

post {
  url: {{bffUrl}}/auth/password-reset/confirm
  body: json
  auth: none
}

body:json {
  {
    "email": "",
    "code": "",
    "new_password": ""
  }
}

script:pre-request {
  const axios = require("axios");

  async function mailCode(email, subject) {
    for (let i = 0; i < 30; i++) {
      const { data } = await axios.get(`${bru.getEnvVar("mailpitUrl")}/api/v1/messages`);
      const message = data.messages.find((m) => m.To[0].Address === email && m.Subject.includes(subject));
      const code = message?.Snippet.match(/\d{6}/)?.[0];
      if (code) return code;
      await bru.sleep(300);
    }
    throw new Error(`No "${subject}" email for ${email} in Mailpit`);
  }

  const email = bru.getVar("bobEmail");
  req.setBody({ email, code: await mailCode(email, "reset"), new_password: bru.getEnvVar("newPassword") });
}

tests {
  test("status 204", () => expect(res.status).to.equal(204));
}

docs {
  Revokes every session of Bob (and closes his WebSockets).
}
