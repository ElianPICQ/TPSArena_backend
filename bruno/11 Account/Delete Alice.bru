meta {
  name: Delete Alice
  type: http
  seq: 8
}

post {
  url: {{bffUrl}}/auth/me/delete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceAccess}}
}

body:json {
  {
    "password": "{{password}}"
  }
}

tests {
  test("status 204", () => expect(res.status).to.equal(204));
}

docs {
  POST with the password (not DELETE: the body matters).
}
