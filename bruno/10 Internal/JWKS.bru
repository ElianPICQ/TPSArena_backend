meta {
  name: JWKS
  type: http
  seq: 5
}

get {
  url: {{authUrl}}/.well-known/jwks.json
  auth: none
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("Ed25519 key", () => {
    expect(res.body.keys[0].kty).to.equal("OKP");
    expect(res.body.keys[0].kid).to.be.a("string");
  });
}

docs {
  Auth's public keys; every service verifies access tokens with them.
}
