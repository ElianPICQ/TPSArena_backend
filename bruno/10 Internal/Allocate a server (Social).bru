meta {
  name: Allocate a server (Social)
  type: http
  seq: 2
}

post {
  url: {{serverlistUrl}}/allocations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{socialServiceSecret}}
}

body:json {
  {
    "party_id": "bruno-{{runId}}",
    "member_ids": ["{{aliceId}}"],
    "build_version": "{{buildVersion}}"
  }
}

tests {
  test("status 201", () => expect(res.status).to.equal(201));
  test("one ticket per member", () => {
    expect(res.body.server_id).to.equal(bru.getVar("server2Id"));
    expect(res.body.tickets).to.have.property(bru.getVar("aliceId"));
  });
}

docs {
  What Social calls on launch, with SOCIAL_SERVICE_SECRET.
}
