meta {
  name: Allocate with the wrong secret
  type: http
  seq: 3
}

post {
  url: {{serverlistUrl}}/allocations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{gameServerSecret}}
}

body:json {
  {
    "party_id": "x",
    "member_ids": ["{{aliceId}}"],
    "build_version": "x"
  }
}

tests {
  test("status 401", () => expect(res.status).to.equal(401));
  test("invalid_secret", () => expect(res.body.error).to.equal("invalid_secret"));
}
