meta {
  name: List friends
  type: http
  seq: 6
}

get {
  url: {{bffUrl}}/friends
  auth: bearer
}

auth:bearer {
  token: {{aliceAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("Bob is a friend", () => expect(res.body.friends.map((x) => x.user_id)).to.include(bru.getVar("bobId")));
}
