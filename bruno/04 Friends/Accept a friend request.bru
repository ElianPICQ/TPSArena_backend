meta {
  name: Accept a friend request
  type: http
  seq: 5
}

post {
  url: {{bffUrl}}/friends/requests/{{requestId}}/accept
  auth: bearer
}

auth:bearer {
  token: {{bobAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("now friends with Alice", () => expect(res.body.user_id).to.equal(bru.getVar("aliceId")));
}
