meta {
  name: Match history
  type: http
  seq: 4
}

get {
  url: {{bffUrl}}/players/{{aliceId}}/matches?limit=20
  auth: bearer
}

params:query {
  limit: 20
}

auth:bearer {
  token: {{aliceAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("empty", () => expect(res.body.matches).to.have.lengthOf(0));
}

docs {
  Newest first. Pass next_cursor as `before` for the next page.
}
