meta {
  name: Leaderboard
  type: http
  seq: 1
}

get {
  url: {{bffUrl}}/leaderboards/xp?limit=10
  auth: bearer
}

params:query {
  limit: 10
}

auth:bearer {
  token: {{aliceAccess}}
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("xp board", () => expect(res.body.type).to.equal("xp"));
}

docs {
  type: xp, wins or kills. Query: offset, limit.
}
