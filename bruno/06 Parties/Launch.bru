meta {
  name: Launch
  type: http
  seq: 8
}

post {
  url: {{bffUrl}}/parties/{{partyId}}/launch
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceAccess}}
}

body:json {
  {
    "build_version": "{{buildVersion}}"
  }
}

script:post-response {
  bru.setVar("aliceTicket", res.body.ticket);
}

tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("on our game server", () => expect(res.body.server_id).to.equal(bru.getVar("serverId")));
}

docs {
  Reserves the idle server registered in Game servers (unique build_version per run).
}
