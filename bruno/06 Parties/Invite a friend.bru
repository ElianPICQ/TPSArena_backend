meta {
  name: Invite a friend
  type: http
  seq: 3
}

post {
  url: {{bffUrl}}/parties/{{partyId}}/invite
  body: json
  auth: bearer
}

auth:bearer {
  token: {{aliceAccess}}
}

body:json {
  {
    "user_id": "{{bobId}}"
  }
}

script:post-response {
  bru.setVar("inviteId", res.body.invite_id);
}

tests {
  test("status 201", () => expect(res.status).to.equal(201));
}
