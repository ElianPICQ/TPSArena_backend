# Full stack (repo root). Each service also has its own .env.example for running alone.

# PostgreSQL: one database per service, each in its own container
AUTH_DB_PASSWORD=auth_dev_password
SOCIAL_DB_PASSWORD=social_dev_password
STATS_DB_PASSWORD=stats_dev_password
REALTIME_DB_PASSWORD=realtime_dev_password

# Shared Redis: one ACL user per service (infra/redis/start.sh)
REDIS_ADMIN_PASSWORD=admin_dev_password
AUTH_REDIS_PASSWORD=auth_redis_dev_password
SERVERLIST_REDIS_PASSWORD=serverlist_redis_dev_password
SOCIAL_REDIS_PASSWORD=social_redis_dev_password
STATS_REDIS_PASSWORD=stats_redis_dev_password
REALTIME_REDIS_PASSWORD=realtime_redis_dev_password
AUTH_REDIS_URL=redis://auth:${AUTH_REDIS_PASSWORD}@redis:6379/0
SERVERLIST_REDIS_URL=redis://serverlist:${SERVERLIST_REDIS_PASSWORD}@redis:6379/0
SOCIAL_REDIS_URL=redis://social:${SOCIAL_REDIS_PASSWORD}@redis:6379/0
STATS_REDIS_URL=redis://stats:${STATS_REDIS_PASSWORD}@redis:6379/0
REALTIME_REDIS_URL=redis://realtime:${REALTIME_REDIS_PASSWORD}@redis:6379/0

# How services reach each other inside the stack
AUTH_URL=http://auth:8001
AUTH_JWKS_URL=http://auth:8001/.well-known/jwks.json
SERVERLIST_URL=http://serverlist:8002
SOCIAL_URL=http://social:8003
STATS_URL=http://stats:8004
REALTIME_URL=http://realtime:8005

# Secrets
# Anything but development makes Auth, Server List and Social refuse the change-me-dev-* secrets
# below (they need at least 32 characters).
ENVIRONMENT=development
CODE_SECRET=change-me-dev-code-secret
GAME_SERVER_SECRET=change-me-dev-game-server-secret
SOCIAL_SERVICE_SECRET=change-me-dev-social-service-secret

# SMTP (Mailpit locally; for the alpha use smtp.gmail.com:587 with STARTTLS and an app password)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tpsarena.local
SMTP_STARTTLS=false
