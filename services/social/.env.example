# Social API running alone (docker compose in this folder). Every value has a working default.
SOCIAL_DB_PASSWORD=social_dev_password
AUTH_URL=http://host.docker.internal:8001
AUTH_JWKS_URL=http://host.docker.internal:8001/.well-known/jwks.json
SERVERLIST_URL=http://host.docker.internal:8002
# Anything but development refuses the change-me-dev-* secrets (at least 32 characters).
ENVIRONMENT=development
SOCIAL_SERVICE_SECRET=change-me-dev-social-service-secret
