# Server List API running alone (docker compose in this folder). Every value has a working default.
AUTH_JWKS_URL=http://host.docker.internal:8001/.well-known/jwks.json
# Anything but development refuses the change-me-dev-* secrets (at least 32 characters).
ENVIRONMENT=development
GAME_SERVER_SECRET=change-me-dev-game-server-secret
SOCIAL_SERVICE_SECRET=change-me-dev-social-service-secret
